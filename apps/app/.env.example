# Public values only: they are built into the website.
# Leave the Supabase values empty to run in demo mode (data stays in the browser).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web Push public key (from `npx web-push generate-vapid-keys`). The private key never goes here.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Where /bible and /demo are served from. Empty = same origin as the website.
EXPO_PUBLIC_ASSET_BASE_URL=
# The public website, used for invite links shared from the native apps.
EXPO_PUBLIC_SITE_URL=https://dailybread.pages.dev
